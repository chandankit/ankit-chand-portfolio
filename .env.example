# ---------------------------------------------------------------------------
# Copy to .env.local for local development. On Vercel, add these under
# Project → Settings → Environment Variables. NEVER commit real values.
# ---------------------------------------------------------------------------

# Public base URL of the deployed site (used for canonical URLs, sitemap, OG).
# Optional on Vercel: falls back to the production deployment URL automatically.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# --- Contact form delivery (configure at least one; both may be set) ---------
# Option A: Resend (https://resend.com) transactional email API.
RESEND_API_KEY=
# Inbox that receives contact-form messages.
CONTACT_TO_EMAIL=
# Sender identity. Must be a domain verified in Resend; the default sandbox
# sender only delivers to the email address that owns the Resend account.
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# Option B: any HTTPS webhook that accepts a JSON POST (Slack/Discord/Make/Zapier).
CONTACT_WEBHOOK_URL=

# If neither option is configured, the API answers 503 and the form offers a
# pre-filled email draft instead, so a visitor's message is never lost.
