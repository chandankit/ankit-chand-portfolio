# ---------------------------------------------------------------------------
# Copy to .env.local for local development. On Vercel, add these under
# Project → Settings → Environment Variables. NEVER commit real values.
# ---------------------------------------------------------------------------

# Public base URL of the deployed site (used for canonical URLs, sitemap, OG).
# Optional on Vercel: falls back to the production deployment URL automatically.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# --- Contact form delivery (configure at least one; both may be set) ---------
# Option A: Resend (https://resend.com) transactional email API.
RESEND_API_KEY=
# Inbox that receives contact-form messages.
CONTACT_TO_EMAIL=
# Sender identity. Must be a domain verified in Resend; the default sandbox
# sender only delivers to the email address that owns the Resend account.
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# Option B: any HTTPS webhook that accepts a JSON POST (Slack/Discord/Make/Zapier).
CONTACT_WEBHOOK_URL=

# If neither option is configured, the API answers 503 and the form offers a
# pre-filled email draft instead, so a visitor's message is never lost.

# --- "Ask about Ankit" assistant — OPTIONAL self-hosted model (tier C) -------
# The assistant needs NO environment variables: instant answers (retrieval +
# verified composition) and the in-browser open-weight model (WebLLM) run with
# zero server cost. Set these only if YOU host an open-source model behind an
# OpenAI-compatible endpoint (llama.cpp `llama-server`, Ollama, vLLM, TGI).
# Never point this at a paid API — the project's rule is zero paid inference.
# The endpoint must be reachable from Vercel over HTTPS and protected by a key.
INFERENCE_BASE_URL=
INFERENCE_API_KEY=
INFERENCE_MODEL=
# Shown to visitors, e.g. "Qwen2.5 1.5B (self-hosted)".
INFERENCE_MODEL_LABEL=

# --- Photo Studio (/admin/photo) — OPTIONAL, owner only ----------------------
# Without these, /admin/login shows "disabled" and every admin API answers 404/401.
# Use a long random password (or its SHA-256 hex in ADMIN_PASSWORD_SHA256).
ADMIN_PASSWORD=
ADMIN_PASSWORD_SHA256=
# 32+ random characters, e.g.  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
# Optional: a SELF-HOSTED open-source enhancement service (e.g. rembg or
# Real-ESRGAN behind a small HTTP wrapper) that accepts an image POST and
# returns an image. Leave empty to disable "Request enhancement".
PHOTO_ENHANCER_URL=
# Optional: lets "Publish photo" commit public/images/ankit-chand.jpg.
# Fine-grained token with Contents: read & write on this one repository only.
GITHUB_TOKEN=
GITHUB_REPO=chandankit/ankit-chand-portfolio
